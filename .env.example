# Copy to .env.local and fill in. Never commit .env.local.

# Production URL of the n8n Webhook node (workflow must be active).
N8N_CONTACT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/portfolio-contact

# Must match the value in the n8n "Header Auth" credential (header name: X-Webhook-Secret).
# Generate one with: node -e "console.log(crypto.randomUUID())"
N8N_WEBHOOK_SECRET=
